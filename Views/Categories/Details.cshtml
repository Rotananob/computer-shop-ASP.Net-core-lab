@model Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="container mt-5">
    <h1>@Model.Name</h1>
    
    <div class="card">
        <div class="card-body">
            <p><strong>Description:</strong> @Model.Description</p>
            <h5 class="mt-3">Products in this Category:</h5>
            @if (Model.Products.Any())
            {
                <ul class="list-group">
                    @foreach (var product in Model.Products)
                    {
                        <li class="list-group-item">
                            @product.Name - $@product.Price.ToString("F2")
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No products in this category.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-controller="Categories" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        <a asp-controller="Categories" asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
