@model List<Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    
    <div class="mb-3">
        <a asp-controller="Categories" asp-action="Create" class="btn btn-primary">Add New Category</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>
                        <a asp-controller="Categories" asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <p class="text-muted">No categories available.</p>
    }
</div>
