@model Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="container mt-5">
    <h1>Delete Order #@Model.Id?</h1>

    <div class="alert alert-warning">
        <p>Are you sure you want to delete this order?</p>
    </div>

    <div class="card">
        <div class="card-body">
            <p><strong>Order ID:</strong> #@Model.Id</p>
            <p><strong>Customer:</strong> @Model.Customer?.FirstName @Model.Customer?.LastName</p>
            <p><strong>Order Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy")</p>
            <p><strong>Total Amount:</strong> $@Model.TotalAmount.ToString("F2")</p>
        </div>
    </div>

    <div class="mt-3">
        <form asp-action="Delete" method="post" style="display:inline;">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
