@model List<Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-5">
    <h1>@ViewData["Title"]</h1>
    
    <div class="mb-3">
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary">Create New Order</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Order Date</th>
                <th>Total Amount</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.Customer?.FirstName @order.Customer?.LastName</td>
                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                    <td>$@order.TotalAmount.ToString("F2")</td>
                    <td>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-controller="Orders" asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-controller="Orders" asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Count == 0)
    {
        <p class="text-muted">No orders available.</p>
    }
</div>
