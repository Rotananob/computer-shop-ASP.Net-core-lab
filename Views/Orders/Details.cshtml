@model Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-5">
    <h1>Order #@Model.Id</h1>
    
    <div class="card">
        <div class="card-body">
            <p><strong>Customer:</strong> @Model.Customer?.FirstName @Model.Customer?.LastName</p>
            <p><strong>Email:</strong> @Model.Customer?.Email</p>
            <p><strong>Order Date:</strong> @Model.OrderDate.ToString("MMM dd, yyyy")</p>
            <p><strong>Total Amount:</strong> $@Model.TotalAmount.ToString("F2")</p>
            
            <h5 class="mt-4">Order Items:</h5>
            @if (Model.OrderDetails.Any())
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td>@detail.Product?.Name</td>
                                <td>@detail.Quantity</td>
                                <td>$@detail.UnitPrice.ToString("F2")</td>
                                <td>$@(detail.Quantity * detail.UnitPrice).ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No items in this order.</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Orders" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-controller="Orders" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
